---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import BookStage from '../components/book-stage/BookStage';
import '../styles/codex.css';
import '../styles/scroll-story.css';

const readJson = (relativePath: string) =>
  JSON.parse(fs.readFileSync(path.join(process.cwd(), relativePath), 'utf8'));

const story = readJson('docs/scroll-copy.json');
const editionsData = readJson('public/data/editions.json');
const benchmark = readJson('public/data/benchmark.json');
const graph = readJson('public/data/knowledge-graph.json');
const bookln = readJson('public/data/bookln.json');

const chapterById = Object.fromEntries(
  (story.chapters as Array<Record<string, any>>).map((chapter) => [chapter.id, chapter]),
) as Record<string, any>;

const chapters = [
  { id: 'arrival', href: 'arrival', number: 'P' },
  { id: 'shelf', href: 'shelf', number: '00' },
  { id: 'carry', href: 'carry', number: '01' },
  { id: 'interaction', href: 'interaction', number: '02' },
  { id: 'binding', href: 'binding', number: '03' },
  { id: 'loop', href: 'loop', number: '04' },
  { id: 'return', href: 'return', number: '05' },
  { id: 'benchmark', href: 'benchmark', number: 'A' },
  { id: 'deployment', href: 'deployment', number: 'B' },
  { id: 'chain', href: 'chain', number: 'C' },
];

const editions = editionsData.editions as Array<{
  id: string;
  order: number;
  name: string;
  nameZh: string;
  summaryZh: string;
  priceDisplay: string;
  priceDisplayZh: string;
  featuresZh: string[];
}>;

const benchmarkRows = benchmark.dimensions.map((dimension: Record<string, any>) => ({
  ...dimension,
  cells: benchmark.devices.map((device: Record<string, any>) => ({
    device,
    ...dimension.cells[device.id],
  })),
}));

const graphNodes = graph.nodes as Array<{
  id: string;
  label: string;
  labelZh: string;
  detailZh: string;
}>;

const pageTitle = 'Bookln / THE BOOK. — 纸书，有魂。';
const pageDescription =
  'Bookln (书链) 概念体验：一本普通纸书，扫一次页边码，就连上云端知识图谱与伴读。滚动即展开，无需点击。';
---

<Layout title={pageTitle} description={pageDescription} lang="zh-Hans">
  <BookStage client:load />

  <div class="sx-progress-edge" aria-hidden="true">
    <i></i>
  </div>

  <nav class="sx-rail" aria-label="Chapters">
    <span class="sx-rail__progress" aria-hidden="true">
      <i></i>
    </span>

    <div class="sx-rail__links">
      {chapters.map((chapter) => (
        <a href={`#${chapter.href}`} data-nav={chapter.id}>
          {chapter.number}
        </a>
      ))}
    </div>

    <div class="sx-rail__meta">
      <a href="#chain">Network</a>
      <a href="/spec">Spec 原版</a>
    </div>
  </nav>

  <div class="sx-ticker" aria-hidden="true">
    <span class="sx-ticker__dot"></span>
    <span id="sx-ticker-label">P — PROLOGUE</span>
  </div>

  <div class="sx-hint" aria-hidden="true">
    <i></i>
    <span>Scroll / 向下滚动</span>
  </div>

  <main class="sx-main" id="story">
    <section
      id="arrival"
      class="sx-sec sx-sec--hero"
      data-chapter="arrival"
      data-number="P"
      data-label="PROLOGUE"
      data-telemetry="P · CLOSED · 0.00 W · ANY BOOK"
      aria-labelledby="arrival-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.arrival.number}</b>
          <span>BOOKLN · 每一本纸书，皆可入云</span>
        </p>

        <h1 id="arrival-title" class="sx-hero">
          {chapterById.arrival.titleA}
          <em>{chapterById.arrival.titleB}</em>
        </h1>

        <p class="sx-hero-zh">{chapterById.arrival.line}</p>
        <p class="sx-hero-line">不装电池。不装 App。翻一页，就醒了。</p>
        <p class="sx-line-en">{chapterById.arrival.lineEn}</p>
        <p class="sx-meta">{chapterById.arrival.meta}</p>
      </div>
    </section>

    <div class="sx-band" aria-hidden="true">
      <div class="sx-band__track">
        <span>NO BATTERY</span>
        <span><em>·</em></span>
        <span>NO APP</span>
        <span><em>·</em></span>
        <span>NO FEED</span>
        <span><em>·</em></span>
        <span>NO NOTIFICATIONS</span>
        <span><em>·</em></span>
        <span>∞ BOOKS</span>
        <span><em>·</em></span>
        <span>0.00 W</span>
        <span><em>·</em></span>
        <span>SCROLL TO UNFOLD</span>
      </div>
    </div>

    <section class="sx-handoff" aria-hidden="true">
      <span class="sx-handoff__numeral">00</span>
      <div class="sx-handoff__plate">
        <p class="sx-handoff__kicker">INTERLUDE · 停泊</p>
        <p class="sx-handoff__line">放回架上。</p>
        <p class="sx-handoff__en">Back to the shelf. It will remember the page.</p>
        <p class="sx-handoff__meta">0.00 W · NO ACCOUNT · ∞ BOOKS</p>
      </div>
    </section>

    <div class="sx-handoff-gap" aria-hidden="true"></div>

    <section
      id="shelf"
      class="sx-sec sx-sec--shelf"
      data-chapter="shelf"
      data-number="00"
      data-label="SHELF"
      data-telemetry="00 · ON SHELF · DORMANT · 0.00 W"
      aria-labelledby="shelf-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.shelf.number}</b>
          <span>{chapterById.shelf.label} · {chapterById.shelf.labelZh}</span>
        </p>
        <h2 id="shelf-title" class="sx-title">
          <span>{chapterById.shelf.titleA}</span>
          <em>{chapterById.shelf.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.shelf.line}</p>
        <p class="sx-line-en">{chapterById.shelf.lineEn}</p>
        <p class="sx-meta">{chapterById.shelf.meta}</p>

        <div class="sx-module sx-marks" data-steps>
          <div class="sx-mark" data-step="0">
            <b>SPINE MARK <small>脊码</small></b>
            <em>公开</em>
            <p>扫一下，先试读：目录、样章、一段讲题。</p>
          </div>
          <div class="sx-mark" data-step="1">
            <b>PAGE-EDGE MARK <small>页边码</small></b>
            <em>认领</em>
            <p>扫一下，云魂归你。书不记名。</p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="carry"
      class="sx-sec"
      data-chapter="carry"
      data-number="01"
      data-label="CARRY"
      data-telemetry="01 · PAID & SEALED · TWO BODIES"
      aria-labelledby="carry-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.carry.number}</b>
          <span>{chapterById.carry.label} · {chapterById.carry.labelZh}</span>
        </p>
        <h2 id="carry-title" class="sx-title">
          <span>{chapterById.carry.titleA}</span>
          <em>{chapterById.carry.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.carry.line}</p>
        <p class="sx-line-en">{chapterById.carry.lineEn}</p>
        <p class="sx-meta">{chapterById.carry.meta}</p>

        <div class="sx-module sx-bodies" data-steps>
          <div class="sx-body" data-step="0">
            <b>PAPER BODY <small>纸身</small></b>
            <em>可借</em>
            <p>能借、能送、能丢，仍然是一本书。</p>
          </div>
          <div class="sx-body" data-step="1">
            <b>CLOUD SOUL <small>云魂</small></b>
            <em>随书</em>
            <p>跟着书走，不跟着人走。</p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="interaction"
      class="sx-sec"
      data-chapter="interaction"
      data-number="02"
      data-label="INTERACTION"
      data-telemetry="02 · OPEN 180° · RIBBON → P.042"
      aria-labelledby="interaction-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.interaction.number}</b>
          <span>{chapterById.interaction.label} · {chapterById.interaction.labelZh}</span>
        </p>
        <h2 id="interaction-title" class="sx-title">
          <span>{chapterById.interaction.titleA}</span>
          <em>{chapterById.interaction.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.interaction.line}</p>
        <p class="sx-line-en">{chapterById.interaction.lineEn}</p>
        <p class="sx-meta">{chapterById.interaction.meta}</p>

        <div class="sx-module sx-ribbon">
          <div class="sx-ribbon__track" aria-hidden="true"><i></i></div>
          <div class="sx-ribbon__steps" data-steps>
            <div class="sx-ribbon__step" data-step="0">
              THUMB
              <small>拇指翻页</small>
            </div>
            <div class="sx-ribbon__step" data-step="1">
              RIBBON
              <small>书签落下</small>
            </div>
            <div class="sx-ribbon__step" data-step="2">
              P.042
              <small>地址出现</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="binding"
      class="sx-sec"
      data-chapter="binding"
      data-number="03"
      data-label="BINDING"
      data-telemetry="03 · SCAN ACTIVE · P.042 → 9 NODES"
      aria-labelledby="binding-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.binding.number}</b>
          <span>{chapterById.binding.label} · {chapterById.binding.labelZh}</span>
        </p>
        <h2 id="binding-title" class="sx-title">
          <span>{chapterById.binding.titleA}</span>
          <em>{chapterById.binding.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.binding.line}</p>
        <p class="sx-line-en">{chapterById.binding.lineEn}</p>
        <p class="sx-meta">{chapterById.binding.meta}</p>

        <div class="sx-module">
          <div class="sx-nodes" data-steps data-dispatch="node">
            {graphNodes.map((node, index) => (
              <span
                class="sx-node"
                data-step={index}
                data-node-id={node.id}
                data-label={`${node.label} · ${node.labelZh}`}
                data-detail={node.detailZh}
              >
                {node.label}
                <small>{node.labelZh}</small>
              </span>
            ))}
          </div>

          <div class="sx-readout" aria-live="polite">
            <b data-readout-label>{graphNodes[0].label} · {graphNodes[0].labelZh}</b>
            <span data-readout-detail>{graphNodes[0].detailZh}</span>
          </div>
        </div>
      </div>
    </section>

    <section
      id="loop"
      class="sx-sec"
      data-chapter="loop"
      data-number="04"
      data-label="LOOP"
      data-telemetry="04 · LOOP ACTIVE · RIBBON P.042 · MIND L.07"
      aria-labelledby="loop-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.loop.number}</b>
          <span>{chapterById.loop.label} · {chapterById.loop.labelZh}</span>
        </p>
        <h2 id="loop-title" class="sx-title">
          <span>{chapterById.loop.titleA}</span>
          <em>{chapterById.loop.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.loop.line}</p>
        <p class="sx-line-en">{chapterById.loop.lineEn}</p>
        <p class="sx-meta">{chapterById.loop.meta}</p>

        <div class="sx-module sx-trio" data-steps>
          <figure data-step="0">
            <div class="sx-trio__frame">
              <span class="sx-trio__tag">AUTOPLAY · MUTED</span>
              <video
                data-autoplay
                src="/video/lesson-preview.mp4"
                poster="/video/lesson-preview-poster.webp"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Page 042 concept lesson preview, plays automatically and silently"></video>
            </div>
            <figcaption>
              L07 LESSON
              <small>名师精讲</small>
            </figcaption>
          </figure>

          <figure data-step="1">
            <div class="sx-trio__frame sx-trio__frame--qr">
              <span class="sx-trio__tag">ONE CODE</span>
              <img
                src="/qr/one-code-entry-card.webp"
                alt="Concept QR card for the Bookln one-code entry"
                width="960"
                height="1280"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              QR ENTRY
              <small>一码入网</small>
            </figcaption>
          </figure>

          <figure data-step="2">
            <div class="sx-trio__frame">
              <span class="sx-trio__tag">GRAPH</span>
              <img
                src="/design/knowledge-graph.webp"
                alt="Concept preview of a page-linked knowledge graph"
                width="1600"
                height="1143"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption>
              KNOWLEDGE MAP
              <small>2D 图谱</small>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section
      id="return"
      class="sx-sec"
      data-chapter="return"
      data-number="05"
      data-label="RETURN"
      data-telemetry="05 · UNBOUND · BACK ON SHELF · 0.00 W"
      aria-labelledby="return-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.return.number}</b>
          <span>{chapterById.return.label} · {chapterById.return.labelZh}</span>
        </p>
        <h2 id="return-title" class="sx-title">
          <span>{chapterById.return.titleA}</span>
          <em>{chapterById.return.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.return.line}</p>
        <p class="sx-line-en">{chapterById.return.lineEn}</p>
        <p class="sx-meta">{chapterById.return.meta}</p>

        <div class="sx-module sx-loop-map" data-steps>
          <div data-step="0">
            UNBIND
            <small>云魂解绑</small>
          </div>
          <div data-step="1">
            FORGET
            <small>书不记名</small>
          </div>
          <div data-step="2">
            REOPEN
            <small>等下一位读者</small>
          </div>
        </div>
      </div>
    </section>

    <section
      id="benchmark"
      class="sx-sec sx-sec--wide"
      data-chapter="benchmark"
      data-number="A"
      data-label="BENCHMARK"
      data-telemetry="A · PEDESTAL 45° · PAPER + CLOUD"
      aria-labelledby="benchmark-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.benchmark.number}</b>
          <span>{chapterById.benchmark.label} · {chapterById.benchmark.labelZh}</span>
        </p>
        <h2 id="benchmark-title" class="sx-title">
          <span>{chapterById.benchmark.titleA}</span>
          <em>{chapterById.benchmark.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.benchmark.line}</p>
        <p class="sx-line-en">{chapterById.benchmark.lineEn}</p>
        <p class="sx-meta">{chapterById.benchmark.meta}</p>

        <div class="sx-module sx-table-wrap">
          <table class="sx-table" data-steps>
            <caption class="sr-only">Paper Book + Bookln concept comparison</caption>
            <thead>
              <tr>
                <th scope="col">Dimension</th>
                {benchmark.devices.map((device: Record<string, any>) => (
                  <th scope="col" class={device.id === 'codex-1' ? 'is-paper' : undefined}>
                    {device.name}
                    <small>{device.role === 'concept' ? 'paper + cloud' : device.vendor}</small>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {benchmarkRows.map((row: Record<string, any>, index: number) => (
                <tr data-step={index}>
                  <th scope="row">
                    {row.label}
                    <small>{row.labelZh}</small>
                  </th>
                  {row.cells.map((cell: Record<string, any>) => (
                    <td
                      data-device={cell.device.name}
                      class={cell.device.id === 'codex-1' ? 'is-paper' : undefined}
                    >
                      <span>{cell.value}</span>
                      <small>{cell.valueZh}</small>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
          <p class="sx-table-note">
            概念对照，不是产品评测。资料与方法全文在 <a href="/spec#benchmark-sources">Spec 原版</a>。
          </p>
        </div>
      </div>
    </section>

    <section
      id="deployment"
      class="sx-sec sx-sec--wide"
      data-chapter="deployment"
      data-number="B"
      data-label="DEPLOY"
      data-telemetry="B · SLIPCASE READY · 3 EDITIONS"
      aria-labelledby="deployment-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.deployment.number}</b>
          <span>{chapterById.deployment.label} · {chapterById.deployment.labelZh}</span>
        </p>
        <h2 id="deployment-title" class="sx-title">
          <span>{chapterById.deployment.titleA}</span>
          <em>{chapterById.deployment.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.deployment.line}</p>
        <p class="sx-line-en">{chapterById.deployment.lineEn}</p>
        <p class="sx-meta">{chapterById.deployment.meta}</p>

        <div class="sx-module sx-acc" data-steps data-dispatch="edition">
          {editions.map((edition, index) => (
            <div class="sx-acc__row" data-step={index} data-edition-id={edition.id}>
              <div class="sx-acc__head">
                <b>
                  {edition.name}
                  <small>{edition.nameZh}</small>
                </b>
                <span>{edition.priceDisplayZh}</span>
              </div>
              <div class="sx-acc__body">
                <p>{edition.summaryZh}</p>
                <ul>
                  {edition.featuresZh.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>
                <span class="price">{edition.priceDisplay} · 结算待接入</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section
      id="chain"
      class="sx-sec sx-sec--wide sx-sec--paper"
      data-chapter="chain"
      data-no-phase
      data-number="C"
      data-label="CHAIN"
      data-telemetry="C · REAL NETWORK · 2,600+ PUBLISHERS · 1M+ TITLES"
      aria-labelledby="chain-title"
    >
      <div class="sx-copy">
        <p class="sx-kicker">
          <b>{chapterById.chain.number}</b>
          <span>{chapterById.chain.label} · {chapterById.chain.labelZh}</span>
        </p>
        <h2 id="chain-title" class="sx-title">
          <span>{chapterById.chain.titleA}</span>
          <em>{chapterById.chain.titleB}</em>
        </h2>
        <p class="sx-line">{chapterById.chain.line}</p>
        <p class="sx-line-en">{chapterById.chain.lineEn}</p>
        <p class="sx-meta">{chapterById.chain.meta}</p>

        <div class="sx-module sx-facts" data-steps>
          {bookln.facts.items.map((item: Record<string, string>, index: number) => (
            <div class="sx-fact" data-step={index}>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
              <small>{item.labelZh}</small>
            </div>
          ))}
        </div>

        <p class="sx-table-note">
          云魂不是凭空设定：它是书链既有 B2B 服务在读者端的化身。数据截至 {bookln.facts.asOf}。
        </p>
      </div>

      <div class="sx-paper-mark" aria-hidden="true">BOOKLN</div>
    </section>
  </main>

  <footer class="sx-footer">
    <div class="sx-footer__brand">
      <img src="/brand/bookln-wordmark.svg" alt="Bookln" width="320" height="93" loading="lazy" />
      <p>每一本纸书，皆可入云。一个由书链 Bookln 驱动的概念体验。</p>
    </div>

    <nav class="sx-footer__links" aria-label="Records">
      <a href="/spec">Spec 原版</a>
      <a href="/spec#benchmark-sources">Benchmark sources</a>
      <a href="/data/editions.json">Edition data</a>
      <a href="/data/asset-manifest.json">Asset manifest</a>
      <a href="#arrival">Back to top ↑</a>
    </nav>

    <div class="sx-footer__meta">
      <span>© 2026 Bookln · Every Physical Book, Connected</span>
      <span>No live checkout · No audio · Price pending</span>
    </div>
  </footer>

  <script>
    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

    const sections = Array.from(document.querySelectorAll<HTMLElement>('.sx-sec[data-chapter]'));
    const railLinks = new Map(
      Array.from(document.querySelectorAll<HTMLAnchorElement>('.sx-rail__links a')).map((link) => [
        link.dataset.nav ?? '',
        link,
      ]),
    );
    const ticker = document.querySelector<HTMLElement>('#sx-ticker-label');

    const liveObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-live');
          liveObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
    );

    for (const section of sections) liveObserver.observe(section);

    const popObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          popObserver.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -6% 0px', threshold: 0.12 },
    );

    for (const element of document.querySelectorAll('.sx-rise')) {
      popObserver.observe(element);
    }

    type StepGroup = {
      group: HTMLElement;
      items: HTMLElement[];
      last: number;
      readoutLabel: HTMLElement | null;
      readoutDetail: HTMLElement | null;
    };

    const stepGroups: StepGroup[] = [];
    for (const section of sections) {
      for (const group of Array.from(section.querySelectorAll<HTMLElement>('[data-steps]'))) {
        const parent = group.parentElement;
        stepGroups.push({
          group,
          items: Array.from(group.querySelectorAll<HTMLElement>('[data-step]')),
          last: -2,
          readoutLabel: parent?.querySelector<HTMLElement>('[data-readout-label]') ?? null,
          readoutDetail: parent?.querySelector<HTMLElement>('[data-readout-detail]') ?? null,
        });
      }
    }

    let frame = 0;

    const update = () => {
      frame = 0;
      const viewport = window.innerHeight;
      const marker = viewport * 0.42;
      let current = sections[0];

      for (const section of sections) {
        const rect = section.getBoundingClientRect();
        if (rect.top <= marker) current = section;

        const start = viewport * 0.9;
        const end = viewport * 0.1 - rect.height;
        const progress = clamp01((start - rect.top) / Math.max(1, start - end));
        section.style.setProperty('--p', progress.toFixed(4));
      }

      for (const [id, link] of railLinks) {
        const active = id === current.dataset.chapter;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      document.documentElement.classList.toggle('is-paper', current.id === 'chain');

      if (ticker) {
        ticker.textContent = `${current.dataset.number ?? 'P'} — ${current.dataset.label ?? 'PROLOGUE'}`;
      }

      for (const entry of stepGroups) {
        const section = entry.group.closest<HTMLElement>('.sx-sec');
        if (!section) continue;

        const progress = Number(section.style.getPropertyValue('--p')) || 0;
        const total = entry.items.length;
        if (!total) continue;

        const eased = clamp01((progress - 0.1) / 0.72);
        const active = Math.min(total - 1, Math.floor(eased * total));

        if (active === entry.last) continue;
        entry.last = active;

        entry.items.forEach((item, index) => {
          item.classList.toggle('is-on', index === active);
          item.classList.toggle('is-done', index < active);
        });

        const item = entry.items[active];
        const kind = entry.group.dataset.dispatch;

        if (kind === 'node') {
          window.dispatchEvent(
            new CustomEvent('bookln:node', { detail: { id: item.dataset.nodeId ?? 'page' } }),
          );
          if (entry.readoutLabel && item.dataset.label) {
            entry.readoutLabel.textContent = item.dataset.label;
          }
          if (entry.readoutDetail && item.dataset.detail) {
            entry.readoutDetail.textContent = item.dataset.detail;
          }
        }

        if (kind === 'edition' && item.dataset.editionId) {
          window.dispatchEvent(
            new CustomEvent('bookln:edition', { detail: { id: item.dataset.editionId } }),
          );
        }
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!reducedMotion.matches) {
      const videoObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              void video.play().catch(() => undefined);
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.35 },
      );

      for (const video of Array.from(document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]'))) {
        videoObserver.observe(video);
      }
    }
  </script>
</Layout>
