            <span class="zh-block" lang="zh-Hans">{fz('chain.subtitle')}</span>
          </p>

          <p class="microcopy reveal">
            <span class="desktop-only">{f('chain.annotation')}</span>
            <span class="mobile-only">{fm('chain.annotation')}</span>
            <span class="zh-block" lang="zh-Hans">{fz('chain.annotation')}</span>
          </p>

          <div class="chain-company reveal" aria-label="About Bookln">
            <div class="chain-company__head">
              <span class="chain-company__tag">COMPANY · ABOUT BOOKLN</span>
              <span lang="zh-Hans">书链 · 关于我们</span>
            </div>
            <p class="chain-company__position">
              {bookln.company.positioning}
              <span class="chain-company__en" lang="en">{bookln.company.positioningEn}</span>
            </p>
            <p class="chain-company__summary">
              {bookln.company.summary}
              <span class="chain-company__en" lang="en">{bookln.company.summaryEn}</span>
            </p>
            <dl class="chain-company__meta">
              <div>
                <dt>Company</dt>
                <dd>
                  {bookln.company.legalName}
                  <small>{bookln.company.formerName}</small>
                </dd>
              </div>
              <div>
                <dt>Founded</dt>
                <dd>{bookln.company.founded} · {bookln.company.headquarters}</dd>
              </div>
              <div>
                <dt>Founder / CEO</dt>
                <dd>{bookln.company.founder}<small>{bookln.company.founderRole}</small></dd>
              </div>
              <div>
                <dt>Core product</dt>
                <dd>{bookln.company.product}</dd>
              </div>
            </dl>
          </div>

          <div class="chain-model reveal">
            <div class="chain-model__head">
              <span class="chain-model__tag">{bookln.model.label}</span>
              <span lang="zh-Hans">{bookln.model.labelZh}</span>
            </div>
            <ol class="chain-model__steps">
              {bookln.model.steps.map((step: Record<string, string>, index: number) => (
                <li>
                  <span class="chain-model__num">{String(index + 1).padStart(2, '0')}</span>
                  <b>{step.labelZh}</b>
                  <small>{step.label}</small>
                  <p>{step.detailZh}</p>
                </li>
              ))}
            </ol>
          </div>

          <div class="chain-facts reveal" aria-label="Bookln supply figures">
            <div class="chain-facts__head">
              <span class="chain-facts__tag">SUPPLY · {bookln.facts.asOf}</span>
              <span lang="zh-Hans">{bookln.facts.labelZh} · 截至 {bookln.facts.asOf}</span>
            </div>
            <div class="chain-facts__grid">
              {bookln.facts.items.map((item: Record<string, string>) => (
                <div class="fact">
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                  <small lang="zh-Hans">{item.labelZh}</small>
                </div>
              ))}
            </div>
            <p class="chain-facts__note">
              {bookln.facts.disclaimer}
              <span class="zh-block" lang="zh-Hans">{bookln.facts.disclaimerZh}</span>
            </p>
          </div>

          <div class="benchmark-panel chain-panel reveal">
            <table class="benchmark-table chain-table">
              <caption class="sr-only">Bookln B2B services, grouped as on bookln.cn, and their in-world embodiments</caption>
              <thead>
                <tr>
                  <th scope="col">bookln.cn · B2B service</th>
                  <th scope="col" class="codex-col">In-world embodiment</th>
                </tr>
              </thead>
              {bookln.services.map((group: Record<string, any>) => (
                <tbody class="chain-group">
                  <tr class="chain-group__row">
                    <th scope="colgroup" colspan="2">
                      {group.label}
                      <small lang="zh-Hans">{group.labelZh}</small>
                    </th>
                  </tr>
                  {group.items.map((service: Record<string, string>) => (
                    <tr>
                      <th scope="row">
                        {service.service}
                        <small lang="zh-Hans">{service.serviceZh}</small>
                        <span class="chain-service__detail">{service.detail}</span>
                        <span class="chain-service__detail" lang="zh-Hans">{service.detailZh}</span>
                      </th>
                      <td class="codex-col">
                        {service.world}
                        <small lang="zh-Hans">{service.worldZh}</small>
                      </td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>

          <div class="chain-clients reveal" aria-label="Selected Bookln clients">
            <span class="chain-clients__label">
              {bookln.clients.label}
              <small lang="zh-Hans">{bookln.clients.labelZh}</small>
            </span>
            <ul>
              {bookln.clients.items.map((client: string) => (
                <li>{client}</li>
              ))}
            </ul>
            <p>
              {bookln.clients.disclaimer}
              <span class="zh-block" lang="zh-Hans">{bookln.clients.disclaimerZh}</span>
            </p>
          </div>

          <div class="chain-policies reveal">
            {bookln.policies.map((policy: Record<string, string>) => (
              <div class="policy">
                <span class={`status-pill status-pill--${policy.status}`}>
                  {policy.status === 'pending-business' ? 'PENDING' : 'LOCKED'}
                </span>
                <div>
                  <span class="policy__label">
                    {policy.label}
                    <small lang="zh-Hans">{policy.labelZh}</small>
                  </span>
                  <small>{policy.note}</small>
                  <small lang="zh-Hans">{policy.noteZh}</small>
                </div>
              </div>
            ))}
          </div>

          <p class="microcopy reveal chain-footnote">
            <span class="desktop-only">{f('chain.footnote')}</span>
            <span class="mobile-only">{fm('chain.footnote')}</span>
            <span class="zh-block" lang="zh-Hans">{fz('chain.footnote')}</span>
          </p>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>
  </main>

  <footer class="footer" id="legal">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/brand/bookln-wordmark.svg" alt="Bookln" width="320" height="93" loading="lazy" />
        <p>
          {f('global.legalFooter')}
          <span class="zh-block" lang="zh-Hans">{fz('global.legalFooter')}</span>
        </p>
      </div>

      <div>
        <h3>Storyline</h3>
        <a href="#shelf">00 · Shelf / 停泊</a>
        <a href="#carry">01 · Carry / 携归</a>
        <a href="#interaction">02 · Interaction (P.042) / 寻址</a>
        <a href="#binding">03 · Binding / 认领</a>
        <a href="#loop">04 · Loop / 伴读</a>
        <a href="#return">05 · Return / 传承</a>
        <a href="#benchmark">A · Benchmark / 基准</a>
        <a href="#deployment">B · Deployment / 部署</a>
        <a href="#chain">C · The Chain / 书链</a>
      </div>

      <div>
        <h3>Records</h3>
        <a href="#benchmark-sources">Benchmark sources</a>
        <a href="/data/asset-manifest.json">Asset manifest</a>
        <a href="/data/editions.json">Edition data</a>
        <a href="/data/bookln.json">Bookln business data</a>
        <a href="/data/marks.json">Two-mark rules</a>
        <a href="/fallback/fallback-desktop.webp">Static fallback</a>
        <a href="/video/lesson-preview.vtt">Lesson transcript</a>
      </div>
    </div>

    <div class="footer__meta">
      <span>© 2026 Bookln · Every Physical Book, Connected</span>
      <span>No live checkout · No audio assets · Price and host pending</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    const navLinks = new Map(
      Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]')).map((link) => [
        link.dataset.nav,
        link,
      ]),
    );
    const status = document.querySelector<HTMLElement>('#chapter-status');
    const telemetryEn = document.querySelector<HTMLElement>('#topbar-telemetry');
    const telemetryZh = document.querySelector<HTMLElement>('#topbar-telemetry-zh');
    const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    for (const element of reveals) revealObserver.observe(element);

    let frame = 0;
    const update = () => {
      frame = 0;
      const limit = Math.max(1, root.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / limit));
      root.style.setProperty('--page-progress', progress.toFixed(4));

      const marker = window.innerHeight * 0.42;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }

      for (const [id, link] of navLinks) {
        const active = id === current.dataset.chapter;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      if (status) {
        const number = current.dataset.number ?? '00';
        const label = current.dataset.label ?? 'Arrival';
        status.textContent = `${number} · ${label}`;
      }

      if (telemetryEn && current.dataset.telemetry) {
        telemetryEn.textContent = current.dataset.telemetry;
      }
      if (telemetryZh && current.dataset.telemetryZh) {
        telemetryZh.textContent = current.dataset.telemetryZh;
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);

    // Chapter 03: Interactive 3D Knowledge Graph Node Explorer
    const nodeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-node-btn]'));
    const nodeLabel = document.querySelector<HTMLElement>('#node-readout-label');
    const nodeLabelZh = document.querySelector<HTMLElement>('#node-readout-label-zh');
    const nodeDetail = document.querySelector<HTMLElement>('#node-readout-detail');
    const nodeDetailZh = document.querySelector<HTMLElement>('#node-readout-detail-zh');

    const activateNode = (btn: HTMLButtonElement) => {
      for (const item of nodeButtons) {
        item.classList.toggle('is-active', item === btn);
      }
      const id = btn.dataset.nodeBtn ?? 'page';
      if (nodeLabel && btn.dataset.nodeLabel) nodeLabel.textContent = btn.dataset.nodeLabel;
      if (nodeLabelZh && btn.dataset.nodeLabelZh) nodeLabelZh.textContent = btn.dataset.nodeLabelZh;
      if (nodeDetail && btn.dataset.nodeDetail) nodeDetail.textContent = btn.dataset.nodeDetail;
      if (nodeDetailZh && btn.dataset.nodeDetailZh) nodeDetailZh.textContent = btn.dataset.nodeDetailZh;
      window.dispatchEvent(new CustomEvent('bookln:node', { detail: { id } }));
    };

    for (const btn of nodeButtons) {
      btn.addEventListener('mouseenter', () => activateNode(btn));
      btn.addEventListener('focus', () => activateNode(btn));
      btn.addEventListener('click', () => activateNode(btn));
    }

    // Chapter 03: Companion Dock Tabs (Lesson Video / QR / 2D Graph)
    const companionTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-companion-tab]'));
    const companionPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-companion-panel]'));

    for (const tab of companionTabs) {
      tab.addEventListener('click', () => {
        const target = tab.dataset.companionTab;
        for (const item of companionTabs) {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', active ? 'true' : 'false');
        }
        for (const panel of companionPanels) {
          panel.classList.toggle('is-active', panel.dataset.companionPanel === target);
        }
      });
    }

    // Chapter 00: Two marks, two meanings -> preview layer vs. claim
    type MarkItem = { label: string; labelZh: string };
    type MarkOutcome = {
      status: string;
      statusZh: string;
      tone: 'preview' | 'fallback' | 'soul';
      layer: 'preview' | 'soul';
      note: string;
      noteZh: string;
    };
    type MarkConfig = {
      states: Array<{ id: string; label: string; labelZh: string }>;
      marks: Array<{ id: string; name: string; nameZh: string; ritual: string; ritualZh: string }>;
      outcomes: Record<string, MarkOutcome>;
      layers: Record<string, { label: string; labelZh: string; items: MarkItem[] }>;
    };

    const markConsole = document.querySelector<HTMLElement>('#mark-console');
    const marksConfigEl = document.getElementById('marks-data');

    if (markConsole && marksConfigEl) {
      const config = JSON.parse(marksConfigEl.textContent || '{}') as MarkConfig;
      const stateButtons = Array.from(markConsole.querySelectorAll<HTMLButtonElement>('[data-mark-state]'));
      const markButtons = Array.from(markConsole.querySelectorAll<HTMLButtonElement>('[data-mark-btn]'));
      const markTitleEn = document.querySelector<HTMLElement>('#mark-readout-title');
      const markTitleZh = document.querySelector<HTMLElement>('#mark-readout-title-zh');
      const markStatusEn = document.querySelector<HTMLElement>('#mark-readout-state');
      const markStatusZh = document.querySelector<HTMLElement>('#mark-readout-state-zh');
      const markNoteEn = document.querySelector<HTMLElement>('#mark-readout-note');
      const markNoteZh = document.querySelector<HTMLElement>('#mark-readout-note-zh');
      const markChips = document.querySelector<HTMLElement>('#mark-readout-chips');
      const markReadout = document.querySelector<HTMLElement>('#mark-readout');

      let activeState =
        stateButtons.find((button) => button.classList.contains('is-active'))?.dataset.markState ?? 'unclaimed';
      let activeMark =
        markButtons.find((button) => button.classList.contains('is-active'))?.dataset.markBtn ?? 'spine';

      const setPressed = (buttons: HTMLButtonElement[], target: HTMLButtonElement) => {
        for (const button of buttons) {
          const active = button === target;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        }
      };

      const renderMark = () => {
        const mark = config.marks.find((item) => item.id === activeMark);
        const outcome = config.outcomes[`${activeMark}:${activeState}`];
        const layer = outcome ? config.layers[outcome.layer] : null;
        if (!mark || !outcome) return;

        if (markTitleEn) markTitleEn.textContent = `${mark.name} · ${mark.ritual}`;
        if (markTitleZh) markTitleZh.textContent = `${mark.nameZh} · ${mark.ritualZh}`;
        if (markStatusEn) markStatusEn.textContent = outcome.status;
        if (markStatusZh) markStatusZh.textContent = outcome.statusZh;
        if (markNoteEn) markNoteEn.textContent = outcome.note;
        if (markNoteZh) markNoteZh.textContent = outcome.noteZh;

        if (markReadout) {
          markReadout.classList.toggle('is-preview', outcome.tone === 'preview');
          markReadout.classList.toggle('is-fallback', outcome.tone === 'fallback');
          markReadout.classList.toggle('is-soul', outcome.tone === 'soul');
        }

        if (markChips && layer) {
          markChips.replaceChildren(
            ...layer.items.map((item) => {
              const chip = document.createElement('span');
              chip.className = 'mark-chip';
              chip.textContent = item.label;
              const zh = document.createElement('small');
              zh.lang = 'zh-Hans';
              zh.textContent = item.labelZh;
              chip.append(zh);
              return chip;
            }),
          );
        }
      };

      for (const button of stateButtons) {
        button.addEventListener('click', () => {
          activeState = button.dataset.markState ?? 'unclaimed';
          setPressed(stateButtons, button);
          renderMark();
        });
      }

      for (const button of markButtons) {
        button.addEventListener('click', () => {
          activeMark = button.dataset.markBtn ?? 'spine';
          setPressed(markButtons, button);
          renderMark();
        });
      }
    }

    // Chapter 05: Interactive Edition Switcher -> 3D Slipcase & Book Pose
    const editionCards = Array.from(document.querySelectorAll<HTMLElement>('[data-edition]'));
    const editionStatus = document.querySelector<HTMLElement>('#edition-stage-status');
    const editionDescriptions: Record<string, string> = {
      standard:
        '3D Stage: Standard Edition (Single bound volume + page-edge scan ring) · 正在预览：标配版（单书实体 + 页边扫码入网）',
      pro: '3D Stage: Pro Edition (Clothbound volume inside custom slipcase) · 正在预览：专业典藏版（含定制函套与封签）',
      enterprise:
        '3D Stage: Enterprise Edition (Shared reading constellation active) · 正在预览：机构共读版（同步点亮全息共读网络）',
    };

    const selectEdition = (card: HTMLElement) => {
      const id = (card.dataset.edition ?? 'pro') as 'standard' | 'pro' | 'enterprise';
      for (const item of editionCards) {
        const active = item === card;
        item.classList.toggle('is-selected', active);
        item.setAttribute('aria-checked', active ? 'true' : 'false');
      }
      if (editionStatus && editionDescriptions[id]) {
        editionStatus.textContent = editionDescriptions[id];
      }
      window.dispatchEvent(new CustomEvent('bookln:edition', { detail: { id } }));
    };

    for (const card of editionCards) {
      card.addEventListener('click', () => selectEdition(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectEdition(card);
        }
      });
    }

    // Video player
    const videoFrames = Array.from(document.querySelectorAll<HTMLElement>('[data-video]'));
    for (const frameEl of videoFrames) {
      const button = frameEl.querySelector<HTMLButtonElement>('[data-video-play]');
      const label = button?.querySelector<HTMLElement>('.video-play__label');
      const videoFrame = frameEl.querySelector<HTMLElement>('.video-frame');
      if (!button || !videoFrame) continue;

      let video: HTMLVideoElement | null = null;

      const setPlaying = (playing: boolean) => {
        frameEl.classList.toggle('is-playing', playing);
        button.setAttribute('aria-label', playing ? 'Pause concept lesson preview' : 'Play concept lesson preview');
        if (label) label.textContent = playing ? 'Pause preview' : 'Play 15s margin preview';
      };

      const ensureVideo = () => {
        if (video) return video;

        const element = document.createElement('video');
        element.muted = true;
        element.loop = true;
        element.playsInline = true;
        element.preload = 'metadata';
        element.poster = frameEl.dataset.poster ?? '';
        element.setAttribute('aria-label', 'Concept lesson preview for Page 042');

        const source = document.createElement('source');
        source.src = frameEl.dataset.src ?? '';
        source.type = 'video/mp4';
        element.append(source);

        const track = document.createElement('track');
        track.kind = 'captions';
        track.src = frameEl.dataset.vtt ?? '';
        track.srclang = 'en';
        track.label = 'English';
        track.default = true;
        element.append(track);

        element.addEventListener('play', () => setPlaying(true));
        element.addEventListener('pause', () => setPlaying(false));
        element.addEventListener('click', () => void toggle());
        videoFrame.prepend(element);
        video = element;
        return element;
      };

      const toggle = async () => {
        const element = ensureVideo();
        if (element.paused) {
          try {
            await element.play();
          } catch {
            setPlaying(false);
          }
        } else {
          element.pause();
        }
      };

      button.addEventListener('click', (event) => {
        event.stopPropagation();
        void toggle();
      });
    }
  </script>
</Layout>
