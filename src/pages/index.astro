---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import BookStage from '../components/book-stage/BookStage';
import '../styles/codex.css';

const readJson = (relativePath: string) =>
  JSON.parse(fs.readFileSync(path.join(process.cwd(), relativePath), 'utf8'));

const copyData = readJson('docs/copy-fields.json');
const editionsData = readJson('public/data/editions.json');
const benchmark = readJson('public/data/benchmark.json');
const links = readJson('public/data/links.json');
const graph = readJson('public/data/knowledge-graph.json');

const copy = Object.fromEntries(copyData.fields.map((field: { id: string }) => [field.id, field])) as Record<
  string,
  Record<string, string>
>;

const f = (id: string, key = 'en') => copy[id]?.[key] ?? '';
const fm = (id: string) => copy[id]?.enMobile ?? f(id);
const fz = (id: string) => copy[id]?.zh ?? '';
const fzm = (id: string) => copy[id]?.zhMobile ?? fz(id);

const titleParts = (id: string, accentWords = 1) => {
  const words = f(id).split(' ');
  return {
    lead: words.slice(0, Math.max(0, words.length - accentWords)).join(' '),
    accent: words.slice(-accentWords).join(' '),
  };
};

const arrival = titleParts('arrival.title', 1);
const structure = titleParts('structure.title', 1);
const interaction = titleParts('interaction.title', 2);
const neural = titleParts('neural-link.title', 1);
const benchmarkTitle = titleParts('benchmark.title', 3);
const deployment = titleParts('deployment.title', 1);

const chapters = [
  { id: 'arrival', number: '00', en: 'Arrival', zh: '登场' },
  { id: 'structure', number: '01', en: 'Structure', zh: '结构' },
  { id: 'interaction', number: '02', en: 'Interaction', zh: '交互' },
  { id: 'neural-link', number: '03', en: 'Neural link', zh: '云链' },
  { id: 'benchmark', number: '04', en: 'Benchmark', zh: '基准' },
  { id: 'deployment', number: '05', en: 'Deployment', zh: '部署' },
];

const editions = editionsData.editions as Array<{
  id: string;
  order: number;
  name: string;
  nameZh: string;
  summary: string;
  summaryZh: string;
  price: number | null;
  priceDisplay: string;
  priceDisplayZh: string;
  checkoutUrl: string | null;
  available: boolean;
  recommended: boolean;
  features: string[];
  featuresZh: string[];
}>;

const benchmarkRows = benchmark.dimensions.map((dimension: Record<string, any>) => ({
  ...dimension,
  cells: benchmark.devices.map((device: Record<string, any>) => ({
    device,
    ...dimension.cells[device.id],
  })),
}));

const graphStats = {
  nodes: graph.nodes.length,
  links: graph.links.length,
};

const landingLabel = links.landing.url.replace(/^https?:\/\//, '');
const structureZhTitle = fz('structure.title').replace(/^Cellulose Display™\s*/, '');
const recommendedEdition = editions.find((edition) => edition.recommended);

const pageTitle = 'Bookln / CODEX 1 — The Zero-Watt Cognitive Engine';
const pageDescription =
  'A concept preview of CODEX 1: a paper-first reading object with cellulose display architecture, haptic navigation and a scan-to-context companion layer.';
---

<Layout title={pageTitle} description={pageDescription}>
  <noscript>
    <aside class="noscript-banner">
      <picture>
        <source media="(max-width: 760px)" srcset="/fallback/fallback-mobile.webp" />
        <img src="/fallback/fallback-desktop.webp" alt="Static CODEX 1 fallback poster" width="240" height="167" />
      </picture>
      <div>
        <strong>JavaScript is off.</strong>
        <p>The interactive object is replaced by a static cover. All copy, benchmark notes and edition data remain available below.</p>
        <a href="/fallback/fallback-desktop.webp">Open the static poster</a>
      </div>
    </aside>
  </noscript>

  <BookStage client:load />

  <header class="topbar">
    <a class="brand" href="#arrival" aria-label="Bookln / CODEX 1">
      <img src="/brand/bookln-wordmark.svg" alt="Bookln" width="320" height="93" />
    </a>

    <div class="topbar__status" aria-label="Build status">
      <span class="status-dot" aria-hidden="true"></span>
      <span>Concept build</span>
      <span class="topbar__status-sep" aria-hidden="true">/</span>
      <span>2026-10-26</span>
    </div>

    <nav class="topbar__nav" aria-label="Primary navigation">
      <a href="#structure">Object</a>
      <a href="#neural-link">Neural link</a>
      <a href="#benchmark">Benchmark</a>
      <a class="button button--ghost button--small" href="#editions">Reserve</a>
    </nav>

    <div class="scroll-progress" aria-hidden="true">
      <span></span>
    </div>
  </header>

  <nav class="chapter-rail" aria-label="Chapter navigation">
    {chapters.map((chapter) => (
      <a class="rail-link" href={`#${chapter.id}`} data-nav={chapter.id}>
        <span class="rail-link__num">{chapter.number}</span>
        <span class="rail-link__text">
          <span class="rail-link__label">{chapter.en}</span>
          <span class="rail-link__zh" lang="zh-Hans">{chapter.zh}</span>
        </span>
      </a>
    ))}
  </nav>

  <div class="mobile-chapter-status" aria-live="polite">
    <span id="chapter-status">00 · Arrival</span>
  </div>

  <main id="story">
    <section id="arrival" data-number="00" class="chapter chapter--hero" data-chapter="arrival" data-label="Arrival" aria-labelledby="arrival-title">
      <div class="chapter__grid">
        <div class="chapter__copy hero">
          <p class="eyebrow reveal">
            <span>{f('arrival.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('arrival.eyebrow')}</span>
          </p>

          <h1 id="arrival-title" class="display reveal" style="--reveal-delay: 110ms">
            <span>{arrival.lead}</span>
            <em>{arrival.accent}</em>
          </h1>

          <p class="hero__subtitle reveal" style="--reveal-delay: 220ms">
            <span class="hero__subtitle-en">{f('arrival.subtitle')}</span>
            <span class="hero__subtitle-zh" lang="zh-Hans">{fz('arrival.subtitle')}</span>
          </p>

          <p class="hero__annotation reveal" style="--reveal-delay: 310ms">
            {f('arrival.annotation')}
            <span class="zh-block" lang="zh-Hans">{fz('arrival.annotation')}</span>
          </p>

          <div class="hero__actions reveal" style="--reveal-delay: 390ms">
            <a class="button" href="#structure">
              Explore the object
              <span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href="#editions">Editions</a>
          </div>

          <dl class="spec-strip reveal" style="--reveal-delay: 470ms">
            <div>
              <dt>Format / 开本</dt>
              <dd>148 × 210 × 30 <small>mm</small></dd>
            </div>
            <div>
              <dt>Power cells / 电池</dt>
              <dd>0 <small>†</small></dd>
            </div>
            <div>
              <dt>Objects / 实体</dt>
              <dd>1 <small>object</small></dd>
            </div>
          </dl>

          <a class="scroll-cue reveal" href="#structure" style="--reveal-delay: 560ms">
            <span>
              {f('arrival.scrollCue')}
              <span class="scroll-cue__zh" lang="zh-Hans">{fz('arrival.scrollCue')}</span>
            </span>
            <span class="scroll-cue__line" aria-hidden="true"></span>
          </a>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section id="structure" data-number="01" class="chapter" data-chapter="structure" data-label="Structure" aria-labelledby="structure-title">
      <div class="chapter__grid">
        <div class="chapter__copy">
          <p class="eyebrow reveal">
            <span>{f('structure.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('structure.eyebrow')}</span>
          </p>

          <h2 id="structure-title" class="section-title reveal">
            <span>{structure.lead}</span>
            <em>{structure.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{structureZhTitle}</span>
          </h2>

          <p class="section-subtitle reveal">
            {f('structure.subtitle')}
            <span class="zh-block" lang="zh-Hans">{fz('structure.subtitle')}</span>
          </p>

          <div class="metrics">
            <div class="metric reveal" style="--reveal-delay: 80ms">
              <span class="metric__number">179.9<small>°</small></span>
              <span class="metric__label">{f('structure.metric1')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fz('structure.metric1')}</span>
            </div>
            <div class="metric reveal" style="--reveal-delay: 240ms">
              <span class="metric__number">0<small>battery</small></span>
              <span class="metric__label">{f('structure.metric2')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fz('structure.metric2')}</span>
            </div>
            <div class="metric reveal" style="--reveal-delay: 400ms">
              <span class="metric__number">180<small>°</small></span>
              <span class="metric__label">{f('structure.metric3')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fz('structure.metric3')}</span>
            </div>
          </div>

          <p class="microcopy reveal">
            {f('structure.microcopy')}
            <span class="zh-block" lang="zh-Hans">{fz('structure.microcopy')}</span>
          </p>

          <div class="material-layers reveal" aria-label="Six material layers">
            <span>Cloth cover</span>
            <span>Board</span>
            <span>Ink</span>
            <span>Fibre sheet</span>
            <span>Sewn spine</span>
            <span>Endpaper</span>
          </div>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section id="interaction" data-number="02" class="chapter" data-chapter="interaction" data-label="Interaction" aria-labelledby="interaction-title">
      <div class="chapter__grid">
        <div class="chapter__copy">
          <p class="eyebrow reveal">
            <span>{f('interaction.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('interaction.eyebrow')}</span>
          </p>

          <h2 id="interaction-title" class="section-title reveal">
            <span>{interaction.lead}</span>
            <em>{interaction.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('interaction.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            {f('interaction.subtitle')}
            <span class="zh-block" lang="zh-Hans">{fz('interaction.subtitle')}</span>
          </p>

          <div class="metrics metrics--two">
            <div class="metric reveal" style="--reveal-delay: 100ms">
              <span class="metric__number">0<small>menus</small></span>
              <span class="metric__label">{fm('interaction.metric1')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fz('interaction.metric1')}</span>
            </div>
            <div class="metric reveal" style="--reveal-delay: 260ms">
              <span class="metric__number">280<small>mm</small></span>
              <span class="metric__label">{fm('interaction.metric2')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fzm('interaction.metric2')}</span>
            </div>
          </div>

          <blockquote class="pull-quote reveal">
            “{f('interaction.microcopy')}”
            <span class="zh-block" lang="zh-Hans">{fz('interaction.microcopy')}</span>
          </blockquote>

          <div class="interaction-note reveal">
            <span class="interaction-note__line" aria-hidden="true"></span>
            <span>One object. No onboarding. The gesture is the manual.</span>
            <span class="zh-block" lang="zh-Hans">一件实体，无需教程。手势就是说明书。</span>
          </div>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section id="neural-link" data-number="03" class="chapter chapter--media" data-chapter="neural-link" data-label="Neural link" aria-labelledby="neural-title">
      <div class="chapter__grid chapter__grid--media">
        <div class="chapter__copy">
          <p class="eyebrow reveal">
            <span class="desktop-only">{f('neural-link.eyebrow')}</span>
            <span class="mobile-only">{fm('neural-link.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('neural-link.eyebrow')}</span>
          </p>

          <h2 id="neural-title" class="section-title reveal">
            <span>{neural.lead}</span>
            <em>{neural.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('neural-link.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            {f('neural-link.subtitle')}
            <span class="zh-block" lang="zh-Hans">{fz('neural-link.subtitle')}</span>
          </p>

          <div class="feature-grid">
            <article class="feature-card reveal" style="--reveal-delay: 80ms">
              <h3>{f('neural-link.feature1Title')}</h3>
              <span class="feature-card__zh" lang="zh-Hans">{fz('neural-link.feature1Title')}</span>
              <p>{f('neural-link.feature1Body')}</p>
              <p class="zh-block" lang="zh-Hans">{fz('neural-link.feature1Body')}</p>
            </article>

            <article class="feature-card reveal" style="--reveal-delay: 220ms">
              <h3>{f('neural-link.feature2Title')}</h3>
              <span class="feature-card__zh" lang="zh-Hans">{fz('neural-link.feature2Title')}</span>
              <p class="desktop-only">{f('neural-link.feature2Body')}</p>
              <p class="mobile-only">{fm('neural-link.feature2Body')}</p>
              <p class="zh-block" lang="zh-Hans">{fz('neural-link.feature2Body')}</p>
            </article>
          </div>

          <p class="microcopy reveal">
            {f('neural-link.microcopy')}
            <span class="zh-block" lang="zh-Hans">{fz('neural-link.microcopy')}</span>
          </p>
        </div>

        <div class="neural-media">
          <figure class="media-card media-card--graph reveal">
            <span class="media-card__label">Knowledge layer / 知识层</span>
            <img
              src="/design/knowledge-graph.webp"
              alt="Deterministic concept preview of a page-linked knowledge graph with nine nodes: current page, concept, citation, lesson, discussion, glossary, author note, related chapter and AI companion."
              width="1600"
              height="1143"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Deterministic concept preview · {graphStats.nodes} nodes / {graphStats.links} links · not a live AI output.
            </figcaption>
          </figure>

          <figure class="media-card media-card--qr reveal" style="--reveal-delay: 100ms">
            <span class="media-card__label">One-code entry / 一码入网</span>
            <img
              src="/qr/one-code-entry-card.webp"
              alt="Concept QR card for the CODEX 1 one-code entry."
              width="960"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              Preview destination <code>{landingLabel}</code> · placeholder until the production host is supplied.
            </figcaption>
          </figure>

          <figure
            class="media-card media-card--video reveal"
            style="--reveal-delay: 180ms"
            data-video
            data-src="/video/lesson-preview.mp4"
            data-poster="/video/lesson-preview-poster.webp"
            data-vtt="/video/lesson-preview.vtt"
          >
            <span class="media-card__label">Lesson preview / 课程预览</span>
            <div class="video-frame">
              <img
                class="video-poster"
                src="/video/lesson-preview-poster.webp"
                alt="Concept lesson preview poster for CODEX 1"
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
              />
              <button type="button" class="video-play" data-video-play aria-label="Play concept lesson preview">
                <span class="video-play__icon" aria-hidden="true"></span>
                <span class="video-play__label">Play preview</span>
              </button>
            </div>
            <figcaption>
              Concept preview · silent 15-second sequence · not final instructor footage.
              <a class="media-card__file" href="/video/lesson-preview.mp4">Open file</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="benchmark" data-number="04" class="chapter" data-chapter="benchmark" data-label="Benchmark" aria-labelledby="benchmark-title">
      <div class="chapter__grid chapter__grid--benchmark">
        <div class="chapter__copy chapter__copy--wide">
          <p class="eyebrow reveal">
            <span>04 · Field notes</span>
            <span class="eyebrow__zh" lang="zh-Hans">语境对照</span>
          </p>

          <h2 id="benchmark-title" class="section-title reveal">
            <span class="desktop-only">{benchmarkTitle.lead} <em>{benchmarkTitle.accent}</em></span>
            <span class="mobile-only">A Different <em>Engine</em></span>
            <span class="section-title__zh" lang="zh-Hans">{fz('benchmark.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            A concept object measured against the habits of the devices it refuses to become.
            <span class="zh-block" lang="zh-Hans">一件概念实体，对照它所拒绝成为的那些设备习惯。</span>
          </p>

          <div class="benchmark-panel reveal">
            <table class="benchmark-table">
              <caption class="sr-only">CODEX 1 concept comparison table</caption>
              <thead>
                <tr>
                  <th scope="col">Dimension</th>
                  {benchmark.devices.map((device: Record<string, any>) => (
                    <th scope="col" class={device.id === 'codex-1' ? 'codex-col' : undefined}>
                      {device.name}
                      <small>{device.role === 'concept' ? 'concept' : device.vendor}</small>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {benchmarkRows.map((row: Record<string, any>) => (
                  <tr>
                    <th scope="row">
                      {row.label}
                      <small lang="zh-Hans">{row.labelZh}</small>
                    </th>
                    {row.cells.map((cell: Record<string, any>) => (
                      <td class={cell.device.id === 'codex-1' ? 'codex-col' : undefined} data-device={cell.device.name}>
                        <span>{cell.value}</span>
                        <small lang="zh-Hans">{cell.valueZh}</small>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>

            <div class="benchmark-footnotes">
              <p>
                <span class="desktop-only">{f('benchmark.footnote.context')}</span>
                <span class="mobile-only">{fm('benchmark.footnote.context')}</span>
              </p>
              <p>
                <span class="desktop-only">{f('benchmark.footnote.concept')}</span>
                <span class="mobile-only">{fm('benchmark.footnote.concept')}</span>
                <a href="#benchmark-sources">Read the source register ↓</a>
              </p>
            </div>

            <details class="sources" id="benchmark-sources">
              <summary>Full disclosure · method and sources</summary>
              <p class="sources__method">{benchmark.method}</p>
              <div class="sources__grid">
                {benchmark.sources.map((source: Record<string, any>) => (
                  <div class="source">
                    <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
                    <span>{source.publisher} · accessed {source.accessedAt}</span>
                    <small>{source.note}</small>
                  </div>
                ))}
              </div>
              <p class="sources__legal">{benchmark.legal.thirdPartyDisclaimer}</p>
              <p class="sources__legal">{benchmark.legal.conceptClaimDisclaimer}</p>
              <p class="sources__legal">{benchmark.legal.comparisonDisclaimer}</p>
            </details>
          </div>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section id="deployment" data-number="05" class="chapter chapter--deployment" data-chapter="deployment" data-label="Deployment" aria-labelledby="deployment-title">
      <div class="chapter__grid chapter__grid--deployment">
        <div class="chapter__copy chapter__copy--wide">
          <p class="eyebrow reveal">
            <span>{f('deployment.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('deployment.eyebrow')}</span>
          </p>

          <h2 id="deployment-title" class="section-title reveal">
            <span>{deployment.lead}</span>
            <em>{deployment.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('deployment.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            {f('deployment.subtitle')}
            <span class="zh-block" lang="zh-Hans">{fz('deployment.subtitle')}</span>
          </p>

          <div class="cta-row reveal">
            <a class="button" href="#editions">
              <span class="desktop-only">{f('deployment.cta')}</span>
              <span class="mobile-only">{fm('deployment.cta')}</span>
            </a>
            {recommendedEdition && (
              <span class="cta-note">Pro is the recommended concept configuration.</span>
            )}
          </div>

          <div class="editions" id="editions">
            {editions.map((edition) => (
              <article class={`edition reveal${edition.recommended ? ' is-recommended' : ''}`} data-edition={edition.id}>
                <div class="edition__top">
                  <span>{String(edition.order).padStart(2, '0')}</span>
                  {edition.recommended ? <span class="edition__badge">Recommended</span> : <span>Edition</span>}
                </div>

                <h3>
                  {edition.name}
                  <span lang="zh-Hans">{edition.nameZh}</span>
                </h3>

                <p>
                  {edition.summary}
                  <span class="zh-block" lang="zh-Hans">{edition.summaryZh}</span>
                </p>

                <ul>
                  {edition.features.map((feature, index) => (
                    <li>
                      <span>{feature}</span>
                      <small lang="zh-Hans">{edition.featuresZh[index]}</small>
                    </li>
                  ))}
                </ul>

                <div class="edition__price">
                  {edition.priceDisplay}
                  <span lang="zh-Hans">{edition.priceDisplayZh}</span>
                </div>

                <button type="button" class="edition__button" disabled aria-disabled="true">
                  Checkout pending · 结算待接入
                </button>
              </article>
            ))}
          </div>

          <p class="editions__note reveal">
            Commerce data is intentionally not invented. Prices and checkout URLs remain pending until the commerce owner supplies final values.
            <span class="zh-block" lang="zh-Hans">价格与结算链接尚未接入；在商务负责人提供最终数据前，本页不展示任何虚构价格。</span>
          </p>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>
  </main>

  <footer class="footer" id="legal">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/brand/bookln-wordmark.svg" alt="Bookln" width="320" height="93" loading="lazy" />
        <p>
          {f('global.legalFooter')}
          <span class="zh-block" lang="zh-Hans">{fz('global.legalFooter')}</span>
        </p>
      </div>

      <div>
        <h3>Explore</h3>
        <a href="#arrival">Arrival / 登场</a>
        <a href="#structure">Structure / 结构</a>
        <a href="#interaction">Interaction / 交互</a>
        <a href="#neural-link">Neural link / 云链</a>
        <a href="#benchmark">Benchmark / 基准</a>
        <a href="#deployment">Deployment / 部署</a>
      </div>

      <div>
        <h3>Records</h3>
        <a href="#benchmark-sources">Benchmark sources</a>
        <a href="/data/asset-manifest.json">Asset manifest</a>
        <a href="/data/editions.json">Edition data</a>
        <a href="/fallback/fallback-desktop.webp">Static fallback</a>
        <a href="/video/lesson-preview.vtt">Lesson transcript</a>
      </div>
    </div>

    <div class="footer__meta">
      <span>© 2026 Bookln · Concept preview</span>
      <span>No live checkout · No audio assets · Price and host pending</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    const navLinks = new Map(
      Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]')).map((link) => [
        link.dataset.nav,
        link,
      ]),
    );
    const status = document.querySelector<HTMLElement>('#chapter-status');
    const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    for (const element of reveals) revealObserver.observe(element);

    let frame = 0;
    const update = () => {
      frame = 0;
      const limit = Math.max(1, root.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / limit));
      root.style.setProperty('--page-progress', progress.toFixed(4));

      const marker = window.innerHeight * 0.42;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }

      for (const [id, link] of navLinks) {
        const active = id === current.dataset.chapter;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      if (status) {
        const number = current.dataset.number ?? '00';
        const label = current.dataset.label ?? 'Arrival';
        status.textContent = `${number} · ${label}`;
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);

    const videoFrames = Array.from(document.querySelectorAll<HTMLElement>('[data-video]'));
    for (const frame of videoFrames) {
      const button = frame.querySelector<HTMLButtonElement>('[data-video-play]');
      const label = button?.querySelector<HTMLElement>('.video-play__label');
      const videoFrame = frame.querySelector<HTMLElement>('.video-frame');
      if (!button || !videoFrame) continue;

      let video: HTMLVideoElement | null = null;

      const setPlaying = (playing: boolean) => {
        frame.classList.toggle('is-playing', playing);
        button.setAttribute('aria-label', playing ? 'Pause concept lesson preview' : 'Play concept lesson preview');
        if (label) label.textContent = playing ? 'Pause preview' : 'Play preview';
      };

      const ensureVideo = () => {
        if (video) return video;

        const element = document.createElement('video');
        element.muted = true;
        element.loop = true;
        element.playsInline = true;
        element.preload = 'metadata';
        element.poster = frame.dataset.poster ?? '';
        element.setAttribute('aria-label', 'Concept lesson preview for CODEX 1');

        const source = document.createElement('source');
        source.src = frame.dataset.src ?? '';
        source.type = 'video/mp4';
        element.append(source);

        const track = document.createElement('track');
        track.kind = 'captions';
        track.src = frame.dataset.vtt ?? '';
        track.srclang = 'en';
        track.label = 'English';
        track.default = true;
        element.append(track);

        element.addEventListener('play', () => setPlaying(true));
        element.addEventListener('pause', () => setPlaying(false));
        element.addEventListener('click', () => void toggle());
        videoFrame.prepend(element);
        video = element;
        return element;
      };

      const toggle = async () => {
        const element = ensureVideo();
        if (element.paused) {
          try {
            await element.play();
          } catch {
            setPlaying(false);
          }
        } else {
          element.pause();
        }
      };

      button.addEventListener('click', (event) => {
        event.stopPropagation();
        void toggle();
      });
    }
  </script>
</Layout>
