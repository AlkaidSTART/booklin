---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import BookStage from '../components/book-stage/BookStage';
import '../styles/codex.css';

const readJson = (relativePath: string) =>
  JSON.parse(fs.readFileSync(path.join(process.cwd(), relativePath), 'utf8'));

const copyData = readJson('docs/copy-fields.json');
const editionsData = readJson('public/data/editions.json');
const benchmark = readJson('public/data/benchmark.json');
const links = readJson('public/data/links.json');
const graph = readJson('public/data/knowledge-graph.json');
const shelf = readJson('public/data/shelf.json');
const companion = readJson('public/data/companion.json');
const bookln = readJson('public/data/bookln.json');
const markData = readJson('public/data/marks.json');

const copy = Object.fromEntries(copyData.fields.map((field: { id: string }) => [field.id, field])) as Record<
  string,
  Record<string, string>
>;

const f = (id: string, key = 'en') => copy[id]?.[key] ?? '';
const fm = (id: string) => copy[id]?.enMobile ?? f(id);
const fz = (id: string) => copy[id]?.zh ?? '';
const fzm = (id: string) => copy[id]?.zhMobile ?? fz(id);

const titleParts = (id: string, accentWords = 1) => {
  const words = f(id).split(' ');
  return {
    lead: words.slice(0, Math.max(0, words.length - accentWords)).join(' '),
    accent: words.slice(-accentWords).join(' '),
  };
};

const arrival = titleParts('arrival.title', 1);
const shelfTitle = titleParts('shelf.title', 1);
const carryTitle = titleParts('carry.title', 1);
const interaction = titleParts('interaction.title', 2);
const neural = titleParts('neural-link.title', 1);
const loopTitle = titleParts('loop.title', 1);
const returnTitle = titleParts('return.title', 1);
const chainTitle = titleParts('chain.title', 3);
const benchmarkTitle = titleParts('benchmark.title', 3);
const deployment = titleParts('deployment.title', 1);

const chapters = [
  {
    id: 'shelf',
    number: '00',
    en: 'Shelf',
    zh: '停泊',
    telemetry: 'ON SHELF · UNCLAIMED · 0.00W · PREVIEW ONLY',
    telemetryZh: '架上未认领 · 仅试读层开放',
  },
  {
    id: 'carry',
    number: '01',
    en: 'Carry',
    zh: '携归',
    telemetry: 'PAID & SEALED · TWO EDITIONS',
    telemetryZh: '封签已烙 · 两个版本一同带走',
  },
  {
    id: 'interaction',
    number: '02',
    en: 'Interaction',
    zh: '寻址',
    telemetry: 'OPEN 180° · RIBBON → P.042',
    telemetryZh: '180° 平摊 · 书签锚定第 042 页',
  },
  {
    id: 'binding',
    number: '03',
    en: 'Binding',
    zh: '认领',
    telemetry: 'SCAN ACTIVE · P.042 → 9 NODES',
    telemetryZh: '第一次链结 · 第 042 页升起云端图谱',
  },
  {
    id: 'loop',
    number: '04',
    en: 'Loop',
    zh: '伴读',
    telemetry: 'LOOP ACTIVE · RIBBON P.042 · MIND L.07',
    telemetryZh: '伴读运行 · 书签停 042 页 · 脑到第 7 讲',
  },
  {
    id: 'return',
    number: '05',
    en: 'Return',
    zh: '传承',
    telemetry: 'UNBOUND · BACK ON SHELF · 0.00W',
    telemetryZh: '解绑归架 · 恢复未认领',
  },
  {
    id: 'benchmark',
    number: 'A',
    en: 'Benchmark',
    zh: '基准',
    telemetry: 'PEDESTAL 45° · PAPER + CLOUD',
    telemetryZh: '45° 台座对照 · 纸端与云端兼得',
  },
  {
    id: 'deployment',
    number: 'B',
    en: 'Deploy',
    zh: '部署',
    telemetry: 'SLIPCASE READY · 3 EDITIONS',
    telemetryZh: '入套交付 · 三种方式接入现实',
  },
  {
    id: 'chain',
    number: 'C',
    en: 'Chain',
    zh: '书链',
    telemetry: 'C · REAL NETWORK · 2,600+ PUBLISHERS · 1M+ TITLES',
    telemetryZh: 'C · 真实网络 · 2,600+ 出版商 · 100 万+ 品种',
  },
];

const editions = editionsData.editions as Array<{
  id: string;
  order: number;
  name: string;
  nameZh: string;
  summary: string;
  summaryZh: string;
  price: number | null;
  priceDisplay: string;
  priceDisplayZh: string;
  checkoutUrl: string | null;
  available: boolean;
  recommended: boolean;
  features: string[];
  featuresZh: string[];
}>;

const graphNodes = graph.nodes as Array<{
  id: string;
  type: string;
  label: string;
  labelZh: string;
  detail: string;
  detailZh: string;
  x: number;
  y: number;
  weight: number;
}>;

const benchmarkRows = benchmark.dimensions.map((dimension: Record<string, any>) => ({
  ...dimension,
  cells: benchmark.devices.map((device: Record<string, any>) => ({
    device,
    ...dimension.cells[device.id],
  })),
}));

const graphStats = {
  nodes: graph.nodes.length,
  links: graph.links.length,
};

const landingLabel = links.landing.url.replace(/^https?:\/\//, '');
const recommendedEdition = editions.find((edition) => edition.recommended);

const markConsoleData = {
  states: markData.states,
  marks: markData.marks,
  outcomes: markData.outcomes,
  layers: {
    preview: { ...markData.layers.preview, items: shelf.preview.contents },
    soul: { ...markData.layers.soul, items: companion.capabilities },
  },
};
const markInitial = markData.outcomes['spine:unclaimed'];
const markInitialPreview = markConsoleData.layers.preview.items;

const pageTitle = 'Bookln / 书链 — Every Physical Book, Connected';
const pageDescription =
  'Bookln (书链) is a full-stack technology partner for education publishing. A scrollytelling concept: how a paper book becomes a connected reading object with page-edge scan-to-context, knowledge graphs and AI study companions.';
---

<Layout title={pageTitle} description={pageDescription}>
  <noscript>
    <aside class="noscript-banner">
      <picture>
        <source media="(max-width: 760px)" srcset="/fallback/fallback-mobile.webp" />
        <img src="/fallback/fallback-desktop.webp" alt="Static Bookln fallback poster" width="240" height="167" />
      </picture>
      <div>
        <strong>JavaScript is off.</strong>
        <p>The interactive 3D book is replaced by a static cover. All narrative chapters, benchmark notes and edition data remain available below.</p>
        <a href="/fallback/fallback-desktop.webp">Open the static poster</a>
      </div>
    </aside>
  </noscript>

  <BookStage client:load />

  <header class="topbar">
    <a class="brand" href="#arrival" aria-label="Bookln / 书链">
      <img src="/brand/bookln-wordmark.svg" alt="Bookln" width="320" height="93" />
    </a>

    <div class="topbar__status" aria-label="Live object telemetry">
      <span class="status-dot" aria-hidden="true"></span>
      <span id="topbar-telemetry">P · CLOSED · 0.00W · ANY BOOK</span>
      <span class="topbar__status-sep" aria-hidden="true">/</span>
      <span id="topbar-telemetry-zh" lang="zh-Hans">序幕 · 合拢静置 · 零功耗实体书</span>
    </div>

    <nav class="topbar__nav" aria-label="Primary navigation">
      <a href="/">Scroll edition</a>
      <a href="#shelf">Shelf</a>
      <a href="#binding">Page 042</a>
      <a href="#loop">Loop</a>
      <a href="#chain">Chain</a>
      <a class="button button--ghost button--small" href="#deployment">Deploy</a>
    </nav>

    <div class="scroll-progress" aria-hidden="true">
      <span></span>
    </div>
  </header>

  <nav class="chapter-rail" aria-label="Chapter navigation">
    {chapters.map((chapter) => (
      <a
        class="rail-link"
        href={`#${chapter.id}`}
        data-nav={chapter.id}
        data-telemetry={`${chapter.number} · ${chapter.telemetry}`}
        data-telemetry-zh={chapter.telemetryZh}
      >
        <span class="rail-link__num">{chapter.number}</span>
        <span class="rail-link__text">
          <span class="rail-link__label">{chapter.en}</span>
          <span class="rail-link__zh" lang="zh-Hans">{chapter.zh}</span>
        </span>
      </a>
    ))}
  </nav>

  <div class="mobile-chapter-status" aria-live="polite">
    <span id="chapter-status">P · PROLOGUE</span>
  </div>

  <main id="story">
    <section
      id="arrival"
      data-number="P"
      class="chapter chapter--hero"
      data-chapter="arrival"
      data-label="PROLOGUE"
      data-telemetry="P · CLOSED · 0.00W · ANY BOOK"
      data-telemetry-zh="序幕 · 合拢静置 · 零功耗实体书"
      aria-labelledby="arrival-title"
    >
      <div class="chapter__grid">
        <div class="chapter__copy hero">
          <p class="eyebrow reveal">
            <span>{f('arrival.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('arrival.eyebrow')}</span>
          </p>

          <h1 id="arrival-title" class="display display--cjk reveal" style="--reveal-delay: 110ms">
            <span>{arrival.lead}</span>
            <em>{arrival.accent}</em>
          </h1>

          <p class="hero__subtitle reveal" style="--reveal-delay: 220ms">
            <span class="hero__subtitle-en">{f('arrival.subtitle')}</span>
            <span class="hero__subtitle-zh" lang="zh-Hans">{fz('arrival.subtitle')}</span>
          </p>

          <p class="hero__annotation reveal" style="--reveal-delay: 310ms">
            {f('arrival.annotation')}
            <span class="zh-block" lang="zh-Hans">{fz('arrival.annotation')}</span>
          </p>

          <div class="story-thread-pill reveal" style="--reveal-delay: 350ms">
            <span class="story-thread-pill__tag">PROLOGUE · ONE BOOK</span>
            <span>The story starts with one book: taken from the shelf, carried home, claimed by a single scan.</span>
            <span class="zh-block" lang="zh-Hans">故事从一本书开始：从架上取下，带回家，扫一次码认领。</span>
          </div>

          <div class="hero__actions reveal" style="--reveal-delay: 390ms">
            <a class="button" href="#interaction">
              Unfold the book
              <span aria-hidden="true">↓</span>
            </a>
            <a class="text-link" href="#binding">Jump to Page 042</a>
          </div>

          <dl class="spec-strip reveal" style="--reveal-delay: 470ms">
            <div>
              <dt>Format / 通用开本</dt>
              <dd>148 × 210 × 30 <small>mm</small></dd>
            </div>
            <div>
              <dt>Power cells / 电池</dt>
              <dd>0 <small>†</small></dd>
            </div>
            <div>
              <dt>Compatibility / 适用</dt>
              <dd>∞ <small>books</small></dd>
            </div>
          </dl>

          <a class="scroll-cue reveal" href="#interaction" style="--reveal-delay: 560ms">
            <span>
              {f('arrival.scrollCue')}
              <span class="scroll-cue__zh" lang="zh-Hans">{fz('arrival.scrollCue')}</span>
            </span>
            <span class="scroll-cue__line" aria-hidden="true"></span>
          </a>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section
      id="shelf"
      data-number="00"
      class="chapter"
      data-chapter="shelf"
      data-label="Shelf"
      data-telemetry="00 · ON SHELF · UNCLAIMED · 0.00W"
      data-telemetry-zh="00 · 架上未认领 · 仅试读层开放"
      aria-labelledby="shelf-title"
    >
      <div class="chapter__grid">
        <div class="chapter__copy">
          <div class="story-bridge reveal">
            <span class="story-bridge__step">PROLOGUE → 00 · REWIND TO THE SHELF</span>
            <span class="story-bridge__zh" lang="zh-Hans">开场那本书从哪来？镜头回卷到书链馆：它在架上，还没被取下。</span>
          </div>

          <p class="eyebrow reveal">
            <span>{f('shelf.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('shelf.eyebrow')}</span>
          </p>

          <h2 id="shelf-title" class="section-title reveal">
            <span>{shelfTitle.lead}</span>
            <em>{shelfTitle.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('shelf.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            <span class="desktop-only">{f('shelf.subtitle')}</span>
            <span class="mobile-only">{fm('shelf.subtitle')}</span>
            <span class="zh-block" lang="zh-Hans">{fz('shelf.subtitle')}</span>
          </p>

          <div class="haven-brief reveal" aria-label="Bookln Haven rules">
            <div class="haven-brief__id">
              <span class="haven-brief__tag">BOOKLN HAVEN / {bookln.haven.nameZh}</span>
              <strong>{bookln.haven.nature}</strong>
              <span class="zh-block" lang="zh-Hans">{bookln.haven.natureZh}</span>
            </div>
            <ul class="haven-rules">
              {bookln.haven.rules.map((rule: Record<string, string>) => (
                <li>
                  <span>{rule.label}<small lang="zh-Hans">{rule.labelZh}</small></span>
                  <em>{rule.detail}</em>
                  <em lang="zh-Hans">{rule.detailZh}</em>
                </li>
              ))}
            </ul>
          </div>

          <div class="mark-console reveal" id="mark-console" aria-label="Two marks, two meanings">
            <div class="mark-console__head">
              <span class="mark-console__tag">{markData.intro.label}</span>
              <span class="mark-console__intro" lang="zh-Hans">{markData.intro.labelZh}</span>
            </div>

            <div class="mark-console__states" role="group" aria-label="Claim state">
              {markData.states.map((state: Record<string, string>, index: number) => (
                <button
                  type="button"
                  class={`mark-state${index === 0 ? ' is-active' : ''}`}
                  data-mark-state={state.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  {state.label}
                  <small lang="zh-Hans">{state.labelZh}</small>
                </button>
              ))}
            </div>

            <div class="mark-console__marks" role="group" aria-label="Choose a mark to scan">
              {markData.marks.map((mark: Record<string, string>, index: number) => (
                <button
                  type="button"
                  class={`mark-choice${index === 0 ? ' is-active' : ''}`}
                  data-mark-btn={mark.id}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  <span class="mark-choice__name">
                    {mark.name}
                    <small lang="zh-Hans">{mark.nameZh}</small>
                  </span>
                  <span class="mark-choice__ritual">
                    {mark.ritual}
                    <small lang="zh-Hans">{mark.ritualZh}</small>
                  </span>
                </button>
              ))}
            </div>

            <div class={`mark-readout is-${markInitial.tone}`} id="mark-readout" aria-live="polite">
              <div class="mark-readout__top">
                <div class="mark-readout__id">
                  <strong id="mark-readout-title">{markData.marks[0].name} · {markData.marks[0].ritual}</strong>
                  <span class="zh-block" id="mark-readout-title-zh" lang="zh-Hans">
                    {markData.marks[0].nameZh} · {markData.marks[0].ritualZh}
                  </span>
                </div>
                <div class="mark-readout__state">
                  <span id="mark-readout-state">{markInitial.status}</span>
                  <small id="mark-readout-state-zh" lang="zh-Hans">{markInitial.statusZh}</small>
                </div>
              </div>
              <p class="mark-readout__note" id="mark-readout-note">{markInitial.note}</p>
              <p class="mark-readout__note zh-block" id="mark-readout-note-zh" lang="zh-Hans">{markInitial.noteZh}</p>
              <div class="mark-chips" id="mark-readout-chips" aria-label="What opens">
                {markInitialPreview.map((item: Record<string, string>) => (
                  <span class="mark-chip">
                    {item.label}
                    <small lang="zh-Hans">{item.labelZh}</small>
                  </span>
                ))}
              </div>
            </div>

            <script
              type="application/json"
              id="marks-data"
              is:inline
              set:html={JSON.stringify(markConsoleData)}
            ></script>
          </div>

          <p class="microcopy reveal">
            <span class="desktop-only">{f('shelf.annotation')}</span>
            <span class="mobile-only">{fm('shelf.annotation')}</span>
            <span class="zh-block" lang="zh-Hans">{fz('shelf.annotation')}</span>
          </p>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section
      id="carry"
      data-number="01"
      class="chapter"
      data-chapter="carry"
      data-label="Carry"
      data-telemetry="01 · PAID & SEALED · TWO EDITIONS"
      data-telemetry-zh="01 · 封签已烙 · 两个版本一同带走"
      aria-labelledby="carry-title"
    >
      <div class="chapter__grid">
        <div class="chapter__copy">
          <div class="story-bridge reveal">
            <span class="story-bridge__step">00 → 01 · THE TAKE</span>
            <span class="story-bridge__zh" lang="zh-Hans">承接上章：手指按下「带走它」。馆内只完成归属转移——认领，留给家里的第一次扫码。</span>
          </div>

          <p class="eyebrow reveal">
            <span>{f('carry.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('carry.eyebrow')}</span>
          </p>

          <h2 id="carry-title" class="section-title reveal">
            <span>{carryTitle.lead}</span>
            <em>{carryTitle.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('carry.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            <span class="desktop-only">{f('carry.subtitle')}</span>
            <span class="mobile-only">{fm('carry.subtitle')}</span>
            <span class="zh-block" lang="zh-Hans">{fz('carry.subtitle')}</span>
          </p>

          <div class="two-bodies reveal" aria-label="Exit receipt: two editions">
            <div class="two-bodies__head">
              <span>{bookln.settlement.tag} / {bookln.settlement.tagZh}</span>
              <span>{bookln.settlement.nameRule} · {bookln.settlement.nameRuleZh}</span>
            </div>

            <div class="two-bodies__grid">
              {bookln.settlement.bodies.map((body: Record<string, string>) => (
                <div class="two-bodies__item">
                  <small>{body.label} / {body.labelZh}</small>
                  <strong>{body.status}</strong>
                  <span lang="zh-Hans">{body.statusZh}</span>
                  <em>{body.detail}</em>
                  <em lang="zh-Hans">{body.detailZh}</em>
                </div>
              ))}
            </div>

            <p class="two-bodies__note">
              {bookln.settlement.note}
              <span class="zh-block" lang="zh-Hans">{bookln.settlement.noteZh}</span>
            </p>

            <div class="two-bodies__policy">
              <span class="status-pill status-pill--pending">{bookln.settlement.policy.statusLabel}</span>
              <span>
                {bookln.settlement.policy.label} / {bookln.settlement.policy.labelZh}
                <small lang="zh-Hans">{bookln.settlement.policy.statusLabelZh}</small>
              </span>
            </div>
          </div>

          <p class="microcopy reveal">
            {f('carry.annotation')}
            <span class="zh-block" lang="zh-Hans">{fz('carry.annotation')}</span>
          </p>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section
      id="interaction"
      data-number="02"
      class="chapter"
      data-chapter="interaction"
      data-label="Interaction"
      data-telemetry="02 · OPEN 180° · RIBBON → P.042"
      data-telemetry-zh="02 · 180° 平摊 · 书签锚定第 042 页"
      aria-labelledby="interaction-title"
    >
      <div class="chapter__grid">
        <div class="chapter__copy">
          <div class="story-bridge reveal">
            <span class="story-bridge__step">01 → 02 · FROM CARRY TO GESTURE</span>
            <span class="story-bridge__zh" lang="zh-Hans">承接上章：两个版本都到了家；现在，用指尖与书签翻到第 042 页——纸端的锚点就位。</span>
          </div>

          <p class="eyebrow reveal">
            <span>{f('interaction.eyebrow')}</span>
            <span class="eyebrow__zh" lang="zh-Hans">{fz('interaction.eyebrow')}</span>
          </p>

          <h2 id="interaction-title" class="section-title reveal">
            <span>{interaction.lead}</span>
            <em>{interaction.accent}</em>
            <span class="section-title__zh" lang="zh-Hans">{fz('interaction.title')}</span>
          </h2>

          <p class="section-subtitle reveal">
            {f('interaction.subtitle')}
            <span class="zh-block" lang="zh-Hans">{fz('interaction.subtitle')}</span>
          </p>

          <div class="metrics metrics--two">
            <div class="metric reveal" style="--reveal-delay: 100ms">
              <span class="metric__number">0<small>menus</small></span>
              <span class="metric__label">{fm('interaction.metric1')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fz('interaction.metric1')}</span>
            </div>
            <div class="metric reveal" style="--reveal-delay: 260ms">
              <span class="metric__number">280<small>mm</small></span>
              <span class="metric__label">{fm('interaction.metric2')}</span>
              <span class="metric__label-zh" lang="zh-Hans">{fzm('interaction.metric2')}</span>
            </div>
          </div>

          <blockquote class="pull-quote reveal">
            “{f('interaction.microcopy')}”
            <span class="zh-block" lang="zh-Hans">{fz('interaction.microcopy')}</span>
          </blockquote>

          <div class="page-anchor-strip reveal" aria-label="Bookmark trajectory to Page 042">
            <div class="page-anchor-strip__item">
              <small>STEP 01</small>
              <span>Thumb fan</span>
              <em lang="zh-Hans">指尖肌肉寻址</em>
            </div>
            <span class="page-anchor-strip__arrow" aria-hidden="true">→</span>
            <div class="page-anchor-strip__item">
              <small>STEP 02</small>
              <span>Ribbon arc</span>
              <em lang="zh-Hans">280mm 织物书签落位</em>
            </div>
            <span class="page-anchor-strip__arrow" aria-hidden="true">→</span>
            <a class="page-anchor-strip__item is-highlight" href="#binding">
              <small>ANCHORED</small>
              <span>Page 042 · Matrix mark</span>
              <em lang="zh-Hans">停在第 042 页 · 准备扫码 ↓</em>
            </a>
          </div>
        </div>

        <div class="chapter__stage-space" aria-hidden="true"></div>
      </div>
    </section>

    <section
      id="binding"
      data-number="03"
      class="chapter"
      data-chapter="binding"
