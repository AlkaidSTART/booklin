        <h3>Records</h3>
        <a href="#benchmark-sources">Benchmark sources</a>
        <a href="/data/asset-manifest.json">Asset manifest</a>
        <a href="/data/editions.json">Edition data</a>
        <a href="/fallback/fallback-desktop.webp">Static fallback</a>
        <a href="/video/lesson-preview.vtt">Lesson transcript</a>
      </div>
    </div>

    <div class="footer__meta">
      <span>© 2026 Bookln · Every Physical Book, Connected</span>
      <span>No live checkout · No audio assets · Price and host pending</span>
    </div>
  </footer>

  <script>
    const root = document.documentElement;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'));
    const navLinks = new Map(
      Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]')).map((link) => [
        link.dataset.nav,
        link,
      ]),
    );
    const status = document.querySelector<HTMLElement>('#chapter-status');
    const telemetryEn = document.querySelector<HTMLElement>('#topbar-telemetry');
    const telemetryZh = document.querySelector<HTMLElement>('#topbar-telemetry-zh');
    const reveals = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    for (const element of reveals) revealObserver.observe(element);

    let frame = 0;
    const update = () => {
      frame = 0;
      const limit = Math.max(1, root.scrollHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / limit));
      root.style.setProperty('--page-progress', progress.toFixed(4));

      const marker = window.innerHeight * 0.42;
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= marker) current = section;
        else break;
      }

      for (const [id, link] of navLinks) {
        const active = id === current.dataset.chapter;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }

      if (status) {
        const number = current.dataset.number ?? '00';
        const label = current.dataset.label ?? 'Arrival';
        status.textContent = `${number} · ${label}`;
      }

      if (telemetryEn && current.dataset.telemetry) {
        telemetryEn.textContent = current.dataset.telemetry;
      }
      if (telemetryZh && current.dataset.telemetryZh) {
        telemetryZh.textContent = current.dataset.telemetryZh;
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);

    // Chapter 01: Interactive 6-layer material inspector -> 3D ExplodedLayers
    const layerButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-layer-btn]'));
    const layerReadoutEn = document.querySelector<HTMLElement>('#layer-readout-en');
    const layerReadoutZh = document.querySelector<HTMLElement>('#layer-readout-zh');

    const activateLayer = (btn: HTMLButtonElement | null) => {
      for (const item of layerButtons) {
        item.classList.toggle('is-active', item === btn);
      }
      if (!btn) {
        window.dispatchEvent(new CustomEvent('bookln:layer', { detail: { index: null } }));
        return;
      }
      const index = Number(btn.dataset.layerBtn ?? 0);
      if (layerReadoutEn && btn.dataset.layerEn) layerReadoutEn.textContent = btn.dataset.layerEn;
      if (layerReadoutZh && btn.dataset.layerZh) layerReadoutZh.textContent = btn.dataset.layerZh;
      window.dispatchEvent(new CustomEvent('bookln:layer', { detail: { index } }));
    };

    for (const btn of layerButtons) {
      btn.addEventListener('mouseenter', () => activateLayer(btn));
      btn.addEventListener('focus', () => activateLayer(btn));
      btn.addEventListener('click', () => activateLayer(btn));
    }

    const materialInspector = document.querySelector<HTMLElement>('.material-inspector');
    materialInspector?.addEventListener('mouseleave', () => {
      window.dispatchEvent(new CustomEvent('bookln:layer', { detail: { index: null } }));
    });

    // Chapter 03: Interactive 3D Knowledge Graph Node Explorer
    const nodeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-node-btn]'));
    const nodeLabel = document.querySelector<HTMLElement>('#node-readout-label');
    const nodeLabelZh = document.querySelector<HTMLElement>('#node-readout-label-zh');
    const nodeDetail = document.querySelector<HTMLElement>('#node-readout-detail');
    const nodeDetailZh = document.querySelector<HTMLElement>('#node-readout-detail-zh');

    const activateNode = (btn: HTMLButtonElement) => {
      for (const item of nodeButtons) {
        item.classList.toggle('is-active', item === btn);
      }
      const id = btn.dataset.nodeBtn ?? 'page';
      if (nodeLabel && btn.dataset.nodeLabel) nodeLabel.textContent = btn.dataset.nodeLabel;
      if (nodeLabelZh && btn.dataset.nodeLabelZh) nodeLabelZh.textContent = btn.dataset.nodeLabelZh;
      if (nodeDetail && btn.dataset.nodeDetail) nodeDetail.textContent = btn.dataset.nodeDetail;
      if (nodeDetailZh && btn.dataset.nodeDetailZh) nodeDetailZh.textContent = btn.dataset.nodeDetailZh;
      window.dispatchEvent(new CustomEvent('bookln:node', { detail: { id } }));
    };

    for (const btn of nodeButtons) {
      btn.addEventListener('mouseenter', () => activateNode(btn));
      btn.addEventListener('focus', () => activateNode(btn));
      btn.addEventListener('click', () => activateNode(btn));
    }

    // Chapter 03: Companion Dock Tabs (Lesson Video / QR / 2D Graph)
    const companionTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-companion-tab]'));
    const companionPanels = Array.from(document.querySelectorAll<HTMLElement>('[data-companion-panel]'));

    for (const tab of companionTabs) {
      tab.addEventListener('click', () => {
        const target = tab.dataset.companionTab;
        for (const item of companionTabs) {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', active ? 'true' : 'false');
        }
        for (const panel of companionPanels) {
          panel.classList.toggle('is-active', panel.dataset.companionPanel === target);
        }
      });
    }

    // Chapter 05: Interactive Edition Switcher -> 3D Slipcase & Book Pose
    const editionCards = Array.from(document.querySelectorAll<HTMLElement>('[data-edition]'));
    const editionStatus = document.querySelector<HTMLElement>('#edition-stage-status');
    const editionDescriptions: Record<string, string> = {
      standard:
        '3D Stage: Standard Edition (Single bound volume + page-edge scan ring) · 正在预览：标配版（单书实体 + 页边扫码入网）',
      pro: '3D Stage: Pro Edition (Clothbound volume inside custom slipcase) · 正在预览：专业典藏版（含定制函套与封签）',
      enterprise:
        '3D Stage: Enterprise Edition (Shared reading constellation active) · 正在预览：机构共读版（同步点亮全息共读网络）',
    };

    const selectEdition = (card: HTMLElement) => {
      const id = (card.dataset.edition ?? 'pro') as 'standard' | 'pro' | 'enterprise';
      for (const item of editionCards) {
        const active = item === card;
        item.classList.toggle('is-selected', active);
        item.setAttribute('aria-checked', active ? 'true' : 'false');
      }
      if (editionStatus && editionDescriptions[id]) {
        editionStatus.textContent = editionDescriptions[id];
      }
      window.dispatchEvent(new CustomEvent('bookln:edition', { detail: { id } }));
    };

    for (const card of editionCards) {
      card.addEventListener('click', () => selectEdition(card));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          selectEdition(card);
        }
      });
    }

    // Video player
    const videoFrames = Array.from(document.querySelectorAll<HTMLElement>('[data-video]'));
    for (const frameEl of videoFrames) {
      const button = frameEl.querySelector<HTMLButtonElement>('[data-video-play]');
      const label = button?.querySelector<HTMLElement>('.video-play__label');
      const videoFrame = frameEl.querySelector<HTMLElement>('.video-frame');
      if (!button || !videoFrame) continue;

      let video: HTMLVideoElement | null = null;

      const setPlaying = (playing: boolean) => {
        frameEl.classList.toggle('is-playing', playing);
        button.setAttribute('aria-label', playing ? 'Pause concept lesson preview' : 'Play concept lesson preview');
        if (label) label.textContent = playing ? 'Pause preview' : 'Play 15s margin preview';
      };

      const ensureVideo = () => {
        if (video) return video;

        const element = document.createElement('video');
        element.muted = true;
        element.loop = true;
        element.playsInline = true;
        element.preload = 'metadata';
        element.poster = frameEl.dataset.poster ?? '';
        element.setAttribute('aria-label', 'Concept lesson preview for Page 042');

        const source = document.createElement('source');
        source.src = frameEl.dataset.src ?? '';
        source.type = 'video/mp4';
        element.append(source);

        const track = document.createElement('track');
        track.kind = 'captions';
        track.src = frameEl.dataset.vtt ?? '';
        track.srclang = 'en';
        track.label = 'English';
        track.default = true;
        element.append(track);

        element.addEventListener('play', () => setPlaying(true));
        element.addEventListener('pause', () => setPlaying(false));
        element.addEventListener('click', () => void toggle());
        videoFrame.prepend(element);
        video = element;
        return element;
      };

      const toggle = async () => {
        const element = ensureVideo();
        if (element.paused) {
          try {
            await element.play();
          } catch {
            setPlaying(false);
          }
        } else {
          element.pause();
        }
      };

      button.addEventListener('click', (event) => {
        event.stopPropagation();
        void toggle();
      });
    }
  </script>
</Layout>
