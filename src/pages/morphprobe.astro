---
<html>
  <head><style>html,body{margin:0;background:#111;height:100%}canvas{display:block}</style></head>
  <body>
    <div id="root"></div>
    <script>
      import * as THREE from 'three';
      import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

      const loader = new GLTFLoader();
      loader.load('/models/book-transformed.glb', (gltf) => {
        const scene = new THREE.Scene();
        scene.background = new THREE.Color('#151312');
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(1440, 900);
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        document.body.appendChild(renderer.domElement);

        const camera = new THREE.PerspectiveCamera(35, 1440 / 900, 0.1, 5000);
        camera.position.set(260, 190, 420);
        camera.lookAt(0, 100, 0);

        scene.add(new THREE.AmbientLight(0xffffff, 1.4));
        const d = new THREE.DirectionalLight(0xffffff, 2.2);
        d.position.set(300, 600, 500);
        scene.add(d);
        const d2 = new THREE.DirectionalLight(0xffe0b0, 1.2);
        d2.position.set(-400, 200, -300);
        scene.add(d2);

        const sets: Array<[number, number, number]> = [
          [0, 0, 0],
          [0, 1, 0],
          [0, 0, 1],
          [0, 0.5, 0.5],
          [0, 0.86, 0],
          [0, 0.04, 0.96],
        ];

        sets.forEach((weights, i) => {
          const clone = gltf.scene.clone(true);
          let mesh: any = null;
          clone.traverse((o: any) => { if (o.isMesh) mesh = o; });
          if (mesh?.morphTargetInfluences) {
            weights.forEach((w, k) => { mesh.morphTargetInfluences[k] = w; });
            mesh.material = mesh.material.clone();
            mesh.material.map = null;
            mesh.material.color = new THREE.Color('#c8b48c');
            mesh.material.needsUpdate = true;
          }
          const g = new THREE.Group();
          g.add(mesh ? mesh : clone);
          const col = i % 3;
          const row = Math.floor(i / 3);
          g.position.set((col - 1) * 420, 240 - row * 320, 0);
          g.scale.setScalar(1);
          scene.add(g);
        });

        const clock = new THREE.Clock();
        const tick = () => {
          renderer.render(scene, camera);
          requestAnimationFrame(tick);
        };
        tick();
        (window as any).__ready = true;
      });
    </script>
  </body>
</html>
