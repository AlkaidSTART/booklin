{
  "version": "2026-10-26",
  "name": "Bookln / CODEX 1 visual tokens",
  "source": "docs/design/visual-spec.html",
  "color": {
    "ink-0": "#11100E",
    "ink-1": "#181613",
    "ink-2": "#211D18",
    "ink-3": "#2B251E",
    "paper": "#E8DCC4",
    "text": "#F3EAD8",
    "muted": "#B9AF9E",
    "faint": "#968D80",
    "gold": "#C8A96D",
    "gold-2": "#A78750",
    "rust": "#9C3F2F",
    "rust-text": "#D27C65",
    "line": "rgba(232, 220, 196, 0.17)",
    "line-strong": "rgba(232, 220, 196, 0.34)"
  },
  "contrast": [
    { "pair": "text / ink-0", "ratio": 15.91, "wcag": "AAA" },
    { "pair": "muted / ink-1", "ratio": 8.33, "wcag": "AAA" },
    { "pair": "gold / ink-1", "ratio": 8.04, "wcag": "AAA" },
    { "pair": "ink-2 / paper", "ratio": 12.34, "wcag": "AAA" },
    { "pair": "faint / ink-0", "ratio": 5.81, "wcag": "AA" },
    { "pair": "faint / ink-1", "ratio": 5.52, "wcag": "AA" },
    { "pair": "faint / ink-2", "ratio": 5.12, "wcag": "AA" },
    { "pair": "faint / ink-3", "ratio": 4.63, "wcag": "AA" },
    { "pair": "rust-text / ink-0", "ratio": 6.17, "wcag": "AA" }
  ],
  "typography": {
    "display": {
      "family": "Cormorant Garamond",
      "fallback": "Bodoni 72, serif",
      "weight": 500,
      "desktop": "clamp(68px, 9vw, 142px)",
      "mobile": "78px",
      "lineHeight": 0.83,
      "letterSpacing": "-0.045em"
    },
    "serif": {
      "family": "Noto Serif SC",
      "fallback": "Songti SC, serif",
      "weight": 500,
      "desktop": "clamp(24px, 3vw, 42px)",
      "mobile": "24px",
      "lineHeight": 1.36,
      "letterSpacing": "-0.025em"
    },
    "sans": {
      "family": "Noto Sans SC",
      "fallback": "PingFang SC, sans-serif",
      "weight": 400,
      "desktop": "16px",
      "mobile": "15px",
      "lineHeight": 1.65
    },
    "utility": {
      "family": "Noto Sans SC",
      "desktop": "9px",
      "mobile": "9px",
      "lineHeight": 1.6,
      "letterSpacing": "0.14em"
    }
  },
  "layout": {
    "breakpoints": {
      "mobile": 390,
      "tablet": 900,
      "desktop": 1440
    },
    "container": {
      "desktop": 1440,
      "desktopGutter": 64,
      "mobileGutter": 18
    },
    "grid": {
      "desktopColumns": 12,
      "mobileColumns": 4
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 40,
      "2xl": 64,
      "3xl": 100
    }
  },
  "components": {
    "button": {
      "height": 46,
      "paddingX": 19,
      "borderWidth": 1,
      "rest": { "background": "#E8DCC4", "color": "#11100E" },
      "hover": { "background": "#C8A96D", "color": "#11100E" },
      "ghost": { "background": "transparent", "color": "#F3EAD8", "borderColor": "rgba(232, 220, 196, 0.34)" },
      "focusRing": "2px solid #C8A96D"
    },
    "card": {
      "borderWidth": 1,
      "borderColor": "rgba(232, 220, 196, 0.17)",
      "background": "rgba(24, 22, 19, 0.72)"
    },
    "table": {
      "cellPadding": "13px 14px",
      "borderColor": "rgba(232, 220, 196, 0.17)",
      "lastColumnBackground": "rgba(200, 169, 109, 0.07)"
    }
  },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "fast": "180ms",
    "base": "420ms",
    "slow": "900ms",
    "scrollScrub": 1.2
  },
  "accessibility": {
    "bodyContrastMinimum": 4.5,
    "focusVisible": "2px solid #C8A96D",
    "reducedMotion": "Respect prefers-reduced-motion; hold the last stable camera pose and reveal copy without parallax."
  }
}
